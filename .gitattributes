# 默认按文本处理
* text=auto

# Windows 脚本必须是 CRLF，否则 .bat 在 cmd 里会报错
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf

# 源码统一 LF
*.js  text eol=lf
*.py  text eol=lf
*.html text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.csv text eol=lf

# 二进制
*.png  binary
*.ico  binary
*.xlsx binary
*.zip  binary
*.pdf  binary
